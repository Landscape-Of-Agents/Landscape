{
  "name": "foxx",
  "displayName": "Landscape",
  "description": "Set up Crane, create policies and selection contracts, and see whether AI agents respect them, from the editor.",
  "version": "0.4.4",
  "publisher": "agentscript",
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0c0a09",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Landscape-Of-Agents/Landscape.git",
    "directory": "extensions/foxx"
  },
  "homepage": "https://agentslandscape.cloud",
  "bugs": {
    "url": "https://github.com/Landscape-Of-Agents/Landscape/issues"
  },
  "keywords": [
    "crane",
    "ai agents",
    "claude code",
    "codex",
    "security",
    "governance",
    "policy"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.crane/registry.json",
    "workspaceContains:.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Landscape runs the Crane CLI and edits repository governance files, so it is disabled in untrusted workspaces."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "foxx.menu",
        "title": "Open Landscape",
        "category": "Landscape",
        "icon": {
          "light": "images/title.png",
          "dark": "images/title.png"
        }
      },
      {
        "command": "foxx.openFile",
        "title": "Open in Landscape",
        "category": "Landscape",
        "icon": {
          "light": "images/title.png",
          "dark": "images/title.png"
        }
      },
      {
        "command": "foxx.setup",
        "title": "Set Up Crane in This Repository",
        "category": "Landscape"
      },
      {
        "command": "foxx.createPolicy",
        "title": "Create Policy",
        "category": "Landscape"
      },
      {
        "command": "foxx.connectZonesFlow",
        "title": "Connect Zones in the Graph",
        "category": "Landscape"
      },
      {
        "command": "foxx.openGraph",
        "title": "Show Governance Graph",
        "category": "Landscape",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "foxx.createCheckpoint",
        "title": "Create Checkpoint",
        "category": "Landscape"
      },
      {
        "command": "foxx.moveToPolicy",
        "title": "Move Selection to Policy",
        "category": "Landscape"
      },
      {
        "command": "foxx.installHooks",
        "title": "Install Agent Hooks",
        "category": "Landscape"
      },
      {
        "command": "foxx.undoGovernanceChange",
        "title": "Undo Last Governance Change",
        "category": "Landscape"
      },
      {
        "command": "foxx.validate",
        "title": "Validate Governance",
        "category": "Landscape",
        "icon": "$(check-all)"
      },
      {
        "command": "foxx.test",
        "title": "Test Policies",
        "category": "Landscape",
        "icon": "$(beaker)"
      },
      {
        "command": "foxx.policyStatus",
        "title": "Policy Status",
        "category": "Landscape"
      },
      {
        "command": "foxx.refresh",
        "title": "Refresh",
        "category": "Landscape",
        "icon": "$(refresh)"
      },
      {
        "command": "foxx.revealSelection",
        "title": "Reveal Selection",
        "category": "Landscape"
      },
      {
        "command": "foxx.openSidebar",
        "title": "Show Overview",
        "category": "Landscape",
        "icon": "$(dashboard)"
      },
      {
        "command": "foxx.revealContext",
        "title": "Open Code of Agent Context",
        "category": "Landscape"
      },
      {
        "command": "foxx.bricks.refresh",
        "title": "Refresh Bricks",
        "category": "Landscape",
        "icon": "$(refresh)"
      },
      {
        "command": "foxx.bricks.create",
        "title": "Create Brick",
        "category": "Landscape",
        "icon": "$(add)"
      },
      {
        "command": "foxx.bricks.edit",
        "title": "Edit Brick",
        "category": "Landscape"
      },
      {
        "command": "foxx.bricks.validate",
        "title": "Validate Brick",
        "category": "Landscape",
        "icon": "$(check)"
      },
      {
        "command": "foxx.bricks.test",
        "title": "Test Brick",
        "category": "Landscape",
        "icon": "$(beaker)"
      },
      {
        "command": "foxx.bricks.show",
        "title": "Show Brick",
        "category": "Landscape"
      },
      {
        "command": "foxx.bricks.activate",
        "title": "Activate Brick (sign)",
        "category": "Landscape",
        "icon": "$(verified)"
      },
      {
        "command": "foxx.bricks.attach",
        "title": "Attach Brick to a Zone or Flow",
        "category": "Landscape",
        "icon": "$(link)"
      },
      {
        "command": "foxx.bricks.detach",
        "title": "Detach Brick",
        "category": "Landscape",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "foxx.bricks.upgrade",
        "title": "Pin Attachment to Another Version",
        "category": "Landscape"
      },
      {
        "command": "foxx.bricks.editContext",
        "title": "Edit Current Context of Attachment",
        "category": "Landscape",
        "icon": "$(edit)"
      },
      {
        "command": "foxx.bricks.revoke",
        "title": "Revoke Brick Version",
        "category": "Landscape"
      },
      {
        "command": "foxx.bricks.preview",
        "title": "Preview Effective Context",
        "category": "Landscape",
        "icon": "$(preview)"
      },
      {
        "command": "foxx.runControl",
        "title": "Run a Crane Control",
        "category": "Landscape",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "foxx.editor",
          "group": "foxx@1",
          "when": "isWorkspaceTrusted"
        }
      ],
      "explorer/context": [
        {
          "command": "foxx.openFile",
          "when": "isWorkspaceTrusted && !explorerResourceIsFolder",
          "group": "foxx@0"
        }
      ],
      "view/title": [
        {
          "command": "foxx.openGraph",
          "when": "view == foxx.sidebar",
          "group": "navigation@0"
        },
        {
          "command": "foxx.test",
          "when": "view == foxx.sidebar || view == foxx.governance",
          "group": "navigation@1"
        },
        {
          "command": "foxx.validate",
          "when": "view == foxx.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "foxx.refresh",
          "when": "view == foxx.sidebar || view == foxx.governance",
          "group": "navigation@3"
        },
        {
          "command": "foxx.bricks.create",
          "when": "view == foxx.bricks",
          "group": "navigation@0"
        },
        {
          "command": "foxx.bricks.preview",
          "when": "view == foxx.bricks",
          "group": "navigation@1"
        },
        {
          "command": "foxx.runControl",
          "when": "view == foxx.bricks",
          "group": "navigation@2"
        },
        {
          "command": "foxx.bricks.refresh",
          "when": "view == foxx.bricks",
          "group": "navigation@3"
        }
      ],
      "foxx.editor": [
        {
          "command": "foxx.menu",
          "when": "isWorkspaceTrusted",
          "group": "0_open@1"
        },
        {
          "command": "foxx.setup",
          "when": "isWorkspaceTrusted && !foxx.ready",
          "group": "1_setup@1"
        },
        {
          "command": "foxx.createPolicy",
          "when": "isWorkspaceTrusted && foxx.ready",
          "group": "4_policy@1"
        },
        {
          "command": "foxx.policyStatus",
          "when": "isWorkspaceTrusted && foxx.ready",
          "group": "4_policy@2"
        },
        {
          "command": "foxx.test",
          "when": "isWorkspaceTrusted && foxx.ready",
          "group": "4_policy@3"
        },
        {
          "command": "foxx.openGraph",
          "when": "isWorkspaceTrusted && foxx.ready",
          "group": "5_graph@1"
        },
        {
          "command": "foxx.connectZonesFlow",
          "when": "isWorkspaceTrusted && foxx.ready",
          "group": "5_graph@2"
        }
      ],
      "editor/title": [
        {
          "command": "foxx.menu",
          "when": "isWorkspaceTrusted && resourceScheme == file",
          "group": "navigation@-100"
        }
      ],
      "commandPalette": [
        {
          "command": "foxx.openFile",
          "when": "false"
        },
        {
          "command": "foxx.revealSelection",
          "when": "false"
        },
        {
          "command": "foxx.revealContext",
          "when": "false"
        },
        {
          "command": "foxx.bricks.show",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "foxx.bricks.validate",
          "when": "view == foxx.bricks && viewItem =~ /^(brick-draft|brick-active|brick-deprecated)$/",
          "group": "1_check@1"
        },
        {
          "command": "foxx.bricks.validate",
          "when": "view == foxx.bricks && viewItem =~ /^(brick-draft|brick-active|brick-deprecated)$/",
          "group": "inline"
        },
        {
          "command": "foxx.bricks.test",
          "when": "view == foxx.bricks && viewItem =~ /^(brick-draft|brick-active|brick-deprecated)$/",
          "group": "1_check@2"
        },
        {
          "command": "foxx.bricks.edit",
          "when": "view == foxx.bricks && viewItem =~ /^(brick-draft|brick-active)$/",
          "group": "2_edit@1"
        },
        {
          "command": "foxx.bricks.activate",
          "when": "view == foxx.bricks && viewItem =~ /^(brick-draft)$/",
          "group": "3_sign@1"
        },
        {
          "command": "foxx.bricks.activate",
          "when": "view == foxx.bricks && viewItem =~ /^(brick-draft)$/",
          "group": "inline"
        },
        {
          "command": "foxx.bricks.attach",
          "when": "view == foxx.bricks && viewItem =~ /^(brick-active|stack-active|target)$/",
          "group": "3_sign@2"
        },
        {
          "command": "foxx.bricks.attach",
          "when": "view == foxx.bricks && viewItem =~ /^(brick-active|stack-active|target)$/",
          "group": "inline"
        },
        {
          "command": "foxx.bricks.revoke",
          "when": "view == foxx.bricks && viewItem =~ /^(brick-active|brick-deprecated)$/",
          "group": "4_withdraw@1"
        },
        {
          "command": "foxx.bricks.editContext",
          "when": "view == foxx.bricks && viewItem =~ /^(attachment)$/",
          "group": "2_edit@1"
        },
        {
          "command": "foxx.bricks.editContext",
          "when": "view == foxx.bricks && viewItem =~ /^(attachment)$/",
          "group": "inline"
        },
        {
          "command": "foxx.bricks.upgrade",
          "when": "view == foxx.bricks && viewItem =~ /^(attachment)$/",
          "group": "3_sign@3"
        },
        {
          "command": "foxx.bricks.detach",
          "when": "view == foxx.bricks && viewItem =~ /^(attachment)$/",
          "group": "4_withdraw@1"
        },
        {
          "command": "foxx.bricks.preview",
          "when": "view == foxx.bricks && viewItem =~ /^(attachment|target)$/",
          "group": "1_check@3"
        },
        {
          "command": "foxx.bricks.preview",
          "when": "view == foxx.bricks && viewItem =~ /^(attachment|target)$/",
          "group": "inline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "foxx.governance",
        "contents": "Crane is not set up in this repository yet.\n[Set Up Crane](command:foxx.setup)\nThis connects the clone to its GitHub repository and creates (or joins) its signed rules.",
        "when": "workspaceFolderCount > 0 && !foxx.ready"
      }
    ],
    "views": {
      "foxx": [
        {
          "type": "webview",
          "id": "foxx.sidebar",
          "name": "Overview"
        },
        {
          "id": "foxx.governance",
          "name": "Governance",
          "icon": "images/activity.svg"
        },
        {
          "id": "foxx.bricks",
          "name": "Bricks",
          "icon": "images/activity.svg"
        }
      ]
    },
    "configuration": {
      "title": "Landscape",
      "properties": {
        "foxx.cranePath": {
          "type": "string",
          "default": "crane",
          "description": "Path of the Crane executable."
        },
        "foxx.validateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run 'crane validate' after a file is saved and show findings as diagnostics."
        },
        "foxx.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show the selection, its policy and its last test outcome above every preserved or targeted block."
        },
        "foxx.agentContext": {
          "type": "boolean",
          "default": true,
          "description": "While an agent works in a selection, zone, or flow that has context, highlight that context next to the code, in the Overview, and in the status bar."
        }
      }
    },
    "submenus": [
      {
        "id": "foxx.editor",
        "label": "Landscape"
      }
    ],
    "keybindings": [
      {
        "command": "foxx.menu",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "editorTextFocus && isWorkspaceTrusted"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "foxx",
          "title": "Landscape",
          "icon": "images/activity.svg"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "foxx.start",
        "title": "Get started with Landscape",
        "description": "Protect code from AI agents, describe the risky parts of your repository, and watch every tool call.",
        "steps": [
          {
            "id": "crane",
            "title": "Install Crane 0.4.10 or newer",
            "description": "Landscape runs the Crane CLI. Download it, put it on PATH or set its path.\n[Download Crane](https://github.com/Landscape-Of-Agents/Landscape/releases)\n[Set Crane path](command:workbench.action.openSettings?%22foxx.cranePath%22)",
            "media": {
              "markdown": "media/walkthrough/crane.md"
            }
          },
          {
            "id": "setup",
            "title": "Set up this repository",
            "description": "Connect the clone to its GitHub repository and create (or join) its signed rules.\n[Set Up Crane](command:foxx.setup)",
            "media": {
              "markdown": "media/walkthrough/setup.md"
            },
            "completionEvents": [
              "onContext:foxx.ready"
            ]
          },
          {
            "id": "select",
            "title": "Preserve or target code",
            "description": "Select lines and press Ctrl+Alt+F. Preserved lines may not be changed by agents; targeted lines are the ones they should change.\n[Open Landscape](command:foxx.menu)",
            "media": {
              "markdown": "media/walkthrough/select.md"
            },
            "completionEvents": [
              "onCommand:foxx.menu"
            ]
          },
          {
            "id": "hooks",
            "title": "Install the agent hooks",
            "description": "Crane checks every tool call of Claude Code or Codex once its hooks are installed.\n[Install hooks](command:foxx.installHooks)",
            "media": {
              "markdown": "media/walkthrough/hooks.md"
            },
            "completionEvents": [
              "onCommand:foxx.installHooks"
            ]
          },
          {
            "id": "overview",
            "title": "Watch the overview",
            "description": "The Landscape overview shows every selection, whether it passes, zones and flows, the governance graph, which agents are working in which flows, findings and what you did.\n[Show Overview](command:foxx.openSidebar)\n[Show Governance Graph](command:foxx.openGraph)",
            "media": {
              "markdown": "media/walkthrough/overview.md"
            },
            "completionEvents": [
              "onView:foxx.sidebar"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test \"out/test/*.test.js\"",
    "package": "vsce package --out foxx.vsix"
  },
  "dependencies": {
    "yaml": "2.5.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.2.2",
    "typescript": "5.5.4"
  }
}
